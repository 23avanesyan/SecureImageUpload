{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Upload": {
    "StorageRoot": "",
    "MaxFileBytes": 10485760,
    "MaxWidth": 8000,
    "MaxHeight": 8000,
    "MaxPixels": 40000000,
    "MaxConcurrentDecodes": 2,
    "ProcessingTimeoutSeconds": 15,
    "DecoderMemoryLimitMegabytes": 512,
    "JpegQuality": 90,
    "UploadsPerMinutePerUser": 10,
    "RejectTrailingData": false,
    "RejectExternalUrls": false,
    "ExtraCanaryDomains": []
  }
}
